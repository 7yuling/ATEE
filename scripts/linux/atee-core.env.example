# Copy to ~/.config/atee/atee-core.env for a user service, or to
# /etc/atee/atee-core.env for a system service. Do not commit real secrets.

# If config/config.json uses llm_api_key_env, the gateway reads this value.
# ATEE_LLM_API_KEY=

# If admin_auth_enabled is true, the admin API reads this value by default.
# ATEE_ADMIN_TOKEN=

# Optional outbound proxy for provider calls when your server requires one.
# Prefer configuring llm_proxy_url in config/config.json when possible.
# HTTPS_PROXY=http://proxy.example:8080
# HTTP_PROXY=http://proxy.example:8080
